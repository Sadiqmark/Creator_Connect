# Server Configuration
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database (PostgreSQL - Phase 2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creator_connect?schema=public

# Firebase Admin Configuration (Phase 3 — In production, genuine non-placeholder credentials are required)
FIREBASE_PROJECT_ID=placeholder-project-id
FIREBASE_CLIENT_EMAIL=placeholder-service-account@placeholder-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----"
EMAIL_RESERVATION_HMAC_SECRET="placeholder_min_32_characters_secret_key_for_reservations"

# Cloudinary Configuration (Phase 19 Part 4 — In production, genuine non-placeholder credentials are required)
CLOUDINARY_CLOUD_NAME=placeholder-cloud-name
CLOUDINARY_API_KEY=placeholder-api-key
CLOUDINARY_API_SECRET=placeholder-api-secret
